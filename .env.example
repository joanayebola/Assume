# Copy this file to .env.local (local) or your host's environment settings.
# .env.local is git-ignored — never commit real keys. Nothing marked
# "server-only" may ever be prefixed with NEXT_PUBLIC_.

# ── Site ──────────────────────────────────────────────────────────────────────
# Public origin. Used for auth email links, OAuth/payment return URLs,
# canonical URLs, sitemap and calendar links. No trailing slash.
# Production: https://assume-day.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the Contact page and error screens.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── Supabase (required) ──────────────────────────────────────────────────────
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_…). NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_…; SUPABASE_SERVICE_ROLE_KEY also works).
# Used by the generation worker, billing (credits, webhooks), calendar token
# storage and account deletion.
SUPABASE_SECRET_KEY=

# ── Gemini (required to build routines) ──────────────────────────────────────
# https://aistudio.google.com/apikey — server-only.
GEMINI_API_KEY=
# Optional. Default gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash
# Optional. Per-request timeout in ms (10000–300000). Default 90000.
# GEMINI_TIMEOUT_MS=90000

# ── Billing: Dodo Payments ───────────────────────────────────────────────────
# "required" (default) — a new routine needs a purchase/credit/subscription.
# "free" — anyone signed in can build routines (private beta / self-hosting).
BILLING_MODE=required
# Free routines per account (0 or 1). Default 0.
FREE_ROUTINE_CREDITS=0
# Dashboard → Developer → API Keys. Server-only.
DODO_PAYMENTS_API_KEY=
# Dashboard → Developer → Webhooks → your endpoint's signing secret (whsec_…).
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode (default) or live_mode — must match the API key.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product id (pdt_…) of the one-time "personalised routine" product.
DODO_PRODUCT_ROUTINE=
# Display price in minor units (1900 = 19.00) and ISO currency. Keep in sync
# with the Dodo product. If unset, the UI says "price shown at checkout".
BILLING_ROUTINE_PRICE=
BILLING_CURRENCY=USD
# Future subscription tier (optional; leave empty until you sell one).
# DODO_PRODUCT_SUBSCRIPTION=
# BILLING_SUBSCRIPTION_PRICE=
# BILLING_SUBSCRIPTION_INTERVAL=month

# ── Google Calendar (optional) ───────────────────────────────────────────────
# Without these, Assume offers .ics calendar files only. Server-only.
# OAuth client (Web). Redirect URIs:
#   http://localhost:3000/api/calendar/google/callback
#   https://assume-day.vercel.app/api/calendar/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Encrypts OAuth tokens at rest. ≥ 32 chars: `openssl rand -base64 32`
# CALENDAR_TOKEN_KEY=
# Search Console "HTML tag" verification code (content="…" value only), used to
# prove you own assume-day.vercel.app for Google OAuth verification.
# GOOGLE_SITE_VERIFICATION=

# ── Analytics (optional, privacy-conscious) ──────────────────────────────────
# none (default) | console | posthog | plausible. Events never contain what
# people write; users are identified by a salted hash.
ANALYTICS_PROVIDER=none
# Salt for hashing user ids (any long random string).
# ANALYTICS_SALT=
# PostHog project API key + host (US or EU cloud, or self-hosted).
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Plausible site domain (+ host if self-hosted).
# PLAUSIBLE_DOMAIN=
# PLAUSIBLE_HOST=https://plausible.io

# ── Demo mode ────────────────────────────────────────────────────────────────
# With Supabase NOT configured, `npm run dev` runs in demo mode: a demo user,
# data in .demo-data/, a local rule-based builder if GEMINI_API_KEY is unset,
# and a *simulated* checkout. Ignored whenever Supabase is configured.
# ASSUME_DEMO_MODE=true
